  "shadow": {
    "1": {
      "$value": {
        "color": "rgb(2 57 51 / 0.06)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "2": {
      "$value": {
        "color": "rgb(2 57 51 / 0.10)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0px"
      }
    },
    "3": {
      "$value": {
        "color": "rgb(2 57 51 / 0.16)",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0px"
      }
    },
    "$type": "shadow"
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "120ms"
    },
    "base": {
      "$value": "200ms"
    },
    "slow": {
      "$value": "320ms"
    },
    "page": {
      "$value": "450ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "exit": {
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    },
    "spring": {
      "$value": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "$description": "Aproximação CSS de spring para toques; a Fase 9 usa spring físico (motion)"
    }
  },
  "z": {
    "$type": "number",
    "base": {
      "$value": 0
    },
    "sticky": {
      "$value": 10
    },
    "dropdown": {
      "$value": 20
