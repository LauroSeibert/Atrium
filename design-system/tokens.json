  },
  "shadow": {
    "1": {
      "$value": {
        "color": "rgb(23 21 15 / 0.08)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "2": {
      "$value": {
        "color": "rgb(23 21 15 / 0.10)",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    },
    "3": {
      "$value": {
        "color": "rgb(23 21 15 / 0.14)",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "40px",
        "spread": "-4px"
      }
    },
    "$type": "shadow"
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "150ms"
    },
    "base": {
      "$value": "200ms"
    },
    "slow": {
      "$value": "320ms"
    },
    "page": {
      "$value": "450ms"
    }
  },
  "loop": {
    "$type": "duration",
    "$description": "Laços contínuos (skeleton). Não viram 1 ms com prefers-reduced-motion: o laço é desligado (animation: none).",
    "shimmer": {
      "$value": "1400ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "exit": {
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    },
    "spring": {
      "$value": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "$description": "Aproximação CSS de spring para toques; a Fase 9 usa spring físico (motion)"
    }
  },
  "z": {
    "$type": "number",
    "base": {
      "$value": 0
    },
    "sticky": {
      "$value": 10
    },
    "dropdown": {
      "$value": 20
    },
    "overlay": {
      "$value": 30
    },
    "modal": {
      "$value": 40
    },
    "popover": {
      "$value": 45,
      "$description": "Popover, menu, select e tooltip: acima de modal/drawer para abrir dentro deles."
    },
    "toast": {
      "$value": 50
    }
  }
}
