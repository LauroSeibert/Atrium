      "$type": "fontFamily",
      "sans": {
        "$value": [
          "var(--font-inter)",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "12px"
      },
      "sm": {
        "$value": "14px"
      },
      "base": {
        "$value": "16px"
      },
      "lg": {
        "$value": "20px"
      },
      "xl": {
        "$value": "24px"
      },
      "2xl": {
        "$value": "32px"
      },
      "3xl": {
        "$value": "40px"
      }
    },
    "line-height": {
      "$type": "number",
      "body": {
        "$value": 1.5
      },
      "heading": {
        "$value": 1.2
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.01em"
      },
      "normal": {
        "$value": "0em"
      },
      "wide": {
        "$value": "0.08em",
        "$description": "Eyebrows em caixa alta"
      }
    }
  },
  "space": {
