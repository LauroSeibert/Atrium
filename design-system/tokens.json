    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    },
    "12": {
      "$value": "48px"
    },
    "16": {
      "$value": "64px"
    },
    "$type": "dimension",
    "$description": "Grade de 4px"
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "6px"
    },
    "md": {
      "$value": "10px"
    },
    "lg": {
      "$value": "14px"
    },
    "xl": {
      "$value": "20px"
    },
    "full": {
      "$value": "999px"
    }
