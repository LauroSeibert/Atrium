  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": {
        "$value": [
          "var(--font-instrument-serif)",
          "ui-serif",
          "Georgia",
          "serif"
        ]
      },
      "sans": {
        "$value": [
          "var(--font-geist)",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "var(--font-geist-mono)",
          "ui-monospace",
          "SFMono-Regular",
          "monospace"
        ]
      },
      "$description": "Instrument Serif (títulos e números de destaque, sempre 400), Geist (interface), Geist Mono (dinheiro em tabelas, horários, códigos)"
    },
    "size": {
      "$type": "dimension",
      "2xs": {
        "$value": "11px",
        "$description": "Eyebrow, rótulos de eixo, contadores"
      },
      "xs": {
        "$value": "12px",
        "$description": "Pílulas, sublinhas"
      },
      "caption": {
        "$value": "13px",
        "$description": "Metadados, variações, links de texto"
      },
      "sm": {
        "$value": "14px",
        "$description": "Texto padrão de interface"
      },
      "md": {
        "$value": "15px",
        "$description": "Títulos de linha em listas, dinheiro em listas"
      },
      "base": {
        "$value": "16px",
        "$description": "Corpo"
      },
      "lg": {
        "$value": "18px",
        "$description": "Ênfase de item"
      },
      "xl": {
        "$value": "22px",
        "$description": "Dinheiro em grade de métricas"
      },
      "2xl": {
        "$value": "30px",
        "$description": "Título de card (serifa)"
      },
      "3xl": {
        "$value": "40px",
        "$description": "Título de seção fora de cards (serifa)"
      },
      "4xl": {
        "$value": "clamp(44px, 3.2vw + 20px, 64px)",
        "$description": "Número de KPI (serifa)"
      },
      "5xl": {
        "$value": "clamp(44px, 4vw + 20px, 68px)",
        "$description": "Título de página H1 (serifa)"
      },
      "6xl": {
        "$value": "clamp(52px, 5vw + 20px, 88px)",
        "$description": "Resultado do mês (serifa)"
      }
    },
    "line-height": {
      "$type": "number",
      "body": {
        "$value": 1.55
      },
      "heading": {
        "$value": 1.2
      },
      "title": {
        "$value": 1.15
      },
      "display": {
        "$value": 1
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.02em"
      },
      "display": {
        "$value": "-0.01em"
      },
      "normal": {
