  "shadow": {
    "1": {
      "$value": {
        "color": "rgb(0 0 0 / 0.04)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "2": {
      "$value": {
        "color": "rgb(0 0 0 / 0.08)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "16px",
        "spread": "-2px"
      }
    },
    "3": {
      "$value": {
        "color": "rgb(0 0 0 / 0.12)",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "40px",
        "spread": "-4px"
      }
    },
    "$type": "shadow"
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "120ms"
    },
    "base": {
      "$value": "200ms"
    },
    "slow": {
      "$value": "320ms"
    },
    "page": {
      "$value": "450ms"
    }
  },
  "loop": {
    "$type": "duration",
    "$description": "Laços contínuos (skeleton). Não viram 1 ms com prefers-reduced-motion: o laço é desligado (animation: none).",
    "shimmer": {
      "$value": "1400ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "exit": {
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    },
    "spring": {
      "$value": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "$description": "Aproximação CSS de spring para toques; a Fase 9 usa spring físico (motion)"
    }
  },
